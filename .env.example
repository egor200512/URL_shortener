# gRPC
GRPC_HOST=localhost
GRPC_AUTH_DOCKER_HOST=localhost
GRPC_AUTH_PORT=8080
GRPC_LINKS_PORT=8081
GRPC_ANALYTICS_PORT=8082

# HTTP and metrics
HTTP_HOST=localhost
HTTP_AUTH_PORT=8083
HTTP_LINKS_PORT=8084
HTTP_ANALYTICS_PORT=8085
METRICS_HOST=0.0.0.0
METRICS_ANALYTICS_PORT=9090
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# PostgreSQL
PG_AUTH_HOST=localhost
PG_LINKS_HOST=localhost
PG_ANALYTICS_HOST=localhost
PG_NAME=user
PG_USER=user
PG_PASSWORD=pass
PG_AUTH_PORT=5432
PG_LINKS_PORT=5433
PG_ANALYTICS_PORT=5434
PG_AUTH_DSN="host=${PG_AUTH_HOST} user=${PG_USER} password=${PG_PASSWORD} dbname=${PG_NAME} port=${PG_AUTH_PORT}"
PG_LINKS_DSN="host=${PG_LINKS_HOST} user=${PG_USER} password=${PG_PASSWORD} dbname=${PG_NAME} port=${PG_LINKS_PORT}"
PG_ANALYTICS_DSN="host=${PG_ANALYTICS_HOST} user=${PG_USER} password=${PG_PASSWORD} dbname=${PG_NAME} port=${PG_ANALYTICS_PORT}"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=red_pass
REDIS_DB=0
REDIS_TTL_MINUTES=600

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_PORT=9092
KAFKA_CLIENT_ID=url_shortener
KAFKA_TOPIC=link_events
KAFKA_DLQ_TOPIC=link_events.dlq
KAFKA_CONSUMER_GROUP=analytics_consumer
KAFKA_CONSUMER_BATCH=100
KAFKA_CONSUMER_WAIT_SECONDS=5
KAFKA_HANDLER_MAX_ATTEMPTS=5
KAFKA_RETRY_BACKOFF_SECONDS=1
KAFKA_RETRY_MAX_BACKOFF_SECONDS=16
KAFKA_PRODUCE_TIMEOUT_SECONDS=10
KAFKA_COMMIT_TIMEOUT_SECONDS=10
KAFKA_TOPIC_PARTITIONS=3
KAFKA_RETENTION_MS=-1

# Migrations
AUTH_MIGRATION_DIR=./services/auth/migrations
LINKS_MIGRATION_DIR=./services/links/migrations
ANALYTICS_MIGRATION_DIR=./services/analytics/migrations

# JWT; replace for non-local environments
JWT_SECRET_KEY=local_secret_key
JWT_ACCESS_EXPIRY_MINUTES=60
