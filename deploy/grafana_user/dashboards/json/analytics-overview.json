{
  "title": "Analytics Overview",
  "uid": "analytics-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["analytics", "prometheus"],
  "panels": [
    {
      "type": "stat",
      "title": "Links Create per second",
      "targets": [
        {
          "expr": "events_per_second_events_per_second{event_type=\"created\"}",
          "legendFormat": "created"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 4}
    },
    {
      "type": "stat",
      "title": "Links GetOriginal per second",
      "targets": [
        {
          "expr": "events_per_second_events_per_second{event_type=\"fetched\"}",
          "legendFormat": "fetched"
        }
      ],
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 4}
    },
    {
      "type": "stat",
      "title": "Links GetInfo per second",
      "targets": [
        {
          "expr": "events_per_second_events_per_second{event_type=\"deleted\"}",
          "legendFormat": "deleted"
        }
      ],
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 4}
    },
    {
      "type": "graph",
      "title": "Go runtime: goroutines",
      "targets": [
        {
          "expr": "go_goroutines{job=\"analytics\"}",
          "legendFormat": "goroutines"
        }
      ],
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 6}
    },
    {
      "type": "graph",
      "title": "Process RSS",
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"analytics\"}",
          "legendFormat": "rss"
        }
      ],
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 6}
    },
    {
      "type": "graph",
      "title": "CPU seconds",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"analytics\"}[5m])",
          "legendFormat": "cpu"
        }
      ],
      "gridPos": {"x": 12, "y": 10, "w": 12, "h": 6}
    },
    {
      "type": "graph",
      "title": "gRPC Throughput (all methods)",
      "targets": [
        {
          "expr": "sum(rate(grpc_server_started_total{grpc_service=\"analytics.AnalyticsService\"}[5m])) by (grpc_method)",
          "legendFormat": "{{grpc_method}}"
        }
      ],
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 6}
    }
  ]
}
